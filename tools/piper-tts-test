#!/bin/bash
set -u
TEXTDOMAIN=piper-tts-server
TEXTDOMAINDIR="${PIPER_LOCALEDIR:-/usr/share/locale}"
export TEXTDOMAIN TEXTDOMAINDIR
if ! command -v gettext >/dev/null 2>&1; then
  gettext() { printf '%s' "$1"; }
fi
VOICES_DIR="${PIPER_VOICES_DIR:-/usr/share/piper-voices}"
CLIENT="${PIPER_TTS_CLIENT:-/usr/bin/piper-tts-client}"
SLOW=-60
NORMAL=-20
FAST=30
declare -A SAMPLE=(
  [ca]="Hola, esta frase està escrita en valencià i prova la veu en valencià del servidor Piper."
  [es]="Hola, esta frase está escrita en español y prueba la voz en español del servidor Piper."
  [de]="Hallo, dieser Satz ist auf Deutsch geschrieben und testet die deutsche Stimme des Piper-Servers."
  [en]="Hello, this sentence is written in English and tests the English voice of the Piper server."
  [fr]="Bonjour, cette phrase est écrite en français et teste la voix française du serveur Piper."
  [it]="Ciao, questa frase è scritta in italiano e prova la voce italiana del server Piper."
  [ru]="Привет, это предложение написано на русском языке и проверяет русский голос сервера Piper."
  [ar]="مرحبًا، هذه الجملة مكتوبة باللغة العربية وتختبر الصوت العربي لخادم Piper."
)
normalize() {
  local code=${1,,}
  code=${code%%-*}
  code=${code%%_*}
  printf '%s\n' "$code"
}
installed_langs() {
  local f
  for f in "$VOICES_DIR"/*.onnx; do
    [ -e "$f" ] || continue
    normalize "$(basename "$f" .onnx)"
  done | sort -u
}
list_languages() {
  if [ -x "$CLIENT" ]; then
    "$CLIENT" --list-languages
  else
    installed_langs
  fi
}
list_voices() {
  local f
  if [ -x "$CLIENT" ]; then
    "$CLIENT" --list-voices
    return
  fi
  for f in "$VOICES_DIR"/*.onnx; do
    [ -e "$f" ] || continue
    basename "$f"
  done
}
voice_for() {
  local f
  for f in "$VOICES_DIR"/*.onnx; do
    [ -e "$f" ] || continue
    if [ "$(normalize "$(basename "$f" .onnx)")" = "$1" ]; then
      basename "$f"
      return 0
    fi
  done
  return 1
}
name_of() {
  local base=${1%%.onnx}
  base=${base#*-}
  base=${base%-*}
  printf '%s\n' "${base,,}"
}
voice_installed() {
  local wanted=${1,,} f name
  local -a exact=() suffix=()
  for f in "$VOICES_DIR"/*.onnx; do
    [ -e "$f" ] || continue
    name=$(name_of "$(basename "$f")")
    if [ "$name" = "$wanted" ]; then
      exact+=("$name")
    elif [ "${name%_"$wanted"}" != "$name" ]; then
      suffix+=("$name")
    fi
  done
  if [ "${#exact[@]}" -gt 0 ]; then
    return 0
  fi
  if [ "${#suffix[@]}" -gt 0 ]; then
    local first=${suffix[0]}
    for name in "${suffix[@]}"; do
      [ "$name" = "$first" ] || return 1
    done
    return 0
  fi
  return 1
}
lang_for_voice() {
  local wanted=${1,,} f name
  for f in "$VOICES_DIR"/*.onnx; do
    [ -e "$f" ] || continue
    name=$(name_of "$(basename "$f")")
    if [ "$name" = "$wanted" ] || [ "${name%_"$wanted"}" != "$name" ]; then
      normalize "$(basename "$f" .onnx)"
      return 0
    fi
  done
  return 1
}
current_lang() {
  local value=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
  [ -n "$value" ] || return 1
  normalize "$value"
}
usage() {
  printf "$(gettext 'usage: %s [language|all] [text] [-l|--lang CODE] [-v|--voice NAME] [-r|--rate RATE|all] [--list-languages] [--list-voices] [-d|--debug]')\n" "$(basename "$0")"
  printf '%s\n' "$(gettext '  -l, --lang CODE     test that specific language (ca, es, de, ...)')"
  printf '%s\n' "$(gettext '  -v, --voice NAME    test that specific voice (thorsten, pau, upc_pau, ...)')"
  printf '%s\n' "$(gettext '  -r, --rate RATE     slow (-60), normal (-20), fast (+30), all, or -100..100')"
  printf '%s\n' "$(gettext '      --list-languages list available languages and exit')"
  printf '%s\n' "$(gettext '      --list-voices    list available voices and exit')"
  printf '%s\n' "$(gettext '  -d, --debug          show piper-tts.service journal messages')"
  printf "$(gettext 'test the Piper voices installed in %s')\n" "$VOICES_DIR"
  exit 1
}
VOICE=""
LANG_OPT=""
RATE=""
DEBUG=0
LIST_LANGS=0
LIST_VOICES=0
JOURNAL_PID=""
declare -a POSITIONALS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -l | --lang)
      [ $# -ge 2 ] || usage
      LANG_OPT=$2
      shift 2
      ;;
    -v | --voice)
      [ $# -ge 2 ] || usage
      VOICE=$2
      shift 2
      ;;
    -r | --rate)
      [ $# -ge 2 ] || usage
      RATE=$2
      shift 2
      ;;
    --list-languages)
      LIST_LANGS=1
      shift
      ;;
    --list-voices)
      LIST_VOICES=1
      shift
      ;;
    -d | --debug)
      DEBUG=1
      shift
      ;;
    -h | --help)
      usage
      ;;
    --)
      shift
      POSITIONALS+=("$@")
      break
      ;;
    -*)
      usage
      ;;
    *)
      POSITIONALS+=("$1")
      shift
      ;;
  esac
done
if [ "$LIST_LANGS" -eq 1 ]; then
  list_languages || exit 1
  if [ "$LIST_VOICES" -eq 1 ]; then
    printf '\n'
  else
    exit 0
  fi
fi
if [ "$LIST_VOICES" -eq 1 ]; then
  list_voices
  exit $?
fi
RATE_ARGS=()
if [ -n "$RATE" ] && [ "$RATE" != all ]; then
  RATE_ARGS=(--rate "$RATE")
fi
start_journal() {
  [ "$DEBUG" -eq 1 ] || return 0
  if ! command -v journalctl >/dev/null 2>&1; then
    printf '%s\n' "$(gettext 'WARNING: journalctl not found; server messages will not be shown')" >&2
    return 0
  fi
  local since
  since=$(date +%s)
  if command -v stdbuf >/dev/null 2>&1; then
    stdbuf -oL journalctl -u piper-tts.service --since="@$since" -f -o short-iso --grep='^(?!Schema error:)' 2>/dev/null &
  else
    journalctl -u piper-tts.service --since="@$since" -f -o short-iso --grep='^(?!Schema error:)' 2>/dev/null &
  fi
  JOURNAL_PID=$!
  sleep 0.2
  if ! kill -0 "$JOURNAL_PID" 2>/dev/null; then
    if command -v stdbuf >/dev/null 2>&1; then
      stdbuf -oL journalctl -u piper-tts.service --since="@$since" -f -o short-iso 2>/dev/null &
    else
      journalctl -u piper-tts.service --since="@$since" -f -o short-iso 2>/dev/null &
    fi
    JOURNAL_PID=$!
    sleep 0.2
  fi
  if ! kill -0 "$JOURNAL_PID" 2>/dev/null; then
    printf '%s\n' "$(gettext 'WARNING: could not read the piper-tts.service journal')" >&2
    JOURNAL_PID=""
  fi
}
stop_journal() {
  if [ -n "${JOURNAL_PID:-}" ]; then
    sleep 0.5
    kill "$JOURNAL_PID" 2>/dev/null || true
    wait "$JOURNAL_PID" 2>/dev/null || true
    JOURNAL_PID=""
  fi
}
trap stop_journal EXIT
trap 'stop_journal; exit 130' INT
trap 'stop_journal; exit 143' TERM
play() {
  local lang=$1 text=$2 file
  if ! file=$(voice_for "$lang"); then
    printf "$(gettext 'ERROR: language not installed: %s')\n" "$lang" >&2
    return 1
  fi
  echo "== $lang ($file)"
  if ! printf '%s\n' "$text" | "$CLIENT" --lang "$lang" "${RATE_ARGS[@]}" --no-fallback; then
    printf "$(gettext 'ERROR: %s did not play')\n" "$lang" >&2
    return 1
  fi
}
rate_sweep() {
  local lang=$1 text=$2 rate value i=0
  local -a rates=(slow normal fast)
  local -a values=("$SLOW" "$NORMAL" "$FAST")
  local fail=0
  for rate in "${rates[@]}"; do
    i=$((i + 1))
    value=$(printf '%+d' "${values[$((i - 1))]}")
    printf "$(gettext '[%d/%d] rate %s (%s): %s')\n" "$i" "${#rates[@]}" "$rate" "$value" "$lang"
    if [ -n "$VOICE" ]; then
      if ! printf '%s\n' "$text" | "$CLIENT" --voice "$VOICE" --rate "$rate" --no-fallback; then
        printf "$(gettext 'ERROR: rate %s failed')\n" "$rate" >&2
        fail=1
        continue
      fi
    else
      if ! printf '%s\n' "$text" | "$CLIENT" --lang "$lang" --rate "$rate" --no-fallback; then
        printf "$(gettext 'ERROR: rate %s failed')\n" "$rate" >&2
        fail=1
        continue
      fi
    fi
    printf "$(gettext 'OK: rate %s tested')\n" "$rate"
  done
  return "$fail"
}
sweep_lang() {
  if [ -n "$VOICE" ] && lang_for_voice "$VOICE"; then
    return 0
  fi
  if [ "$target" != all ]; then
    printf '%s\n' "$target"
    return 0
  fi
  local current
  current=$(current_lang || true)
  if [ -n "$current" ]; then
    case " ${LANGS[*]} " in
      *" $current "*) printf '%s\n' "$current"; return 0 ;;
    esac
  fi
  printf '%s\n' "${LANGS[0]}"
}
TEXT_ARGS=()
if [ -n "$LANG_OPT" ]; then
  target=$(normalize "$LANG_OPT")
  TEXT_ARGS=("${POSITIONALS[@]}")
else
  if [ "${#POSITIONALS[@]}" -gt 0 ]; then
    target=$(normalize "${POSITIONALS[0]}")
    TEXT_ARGS=("${POSITIONALS[@]:1}")
  else
    target=all
  fi
fi
mapfile -t LANGS < <(installed_langs)
if [ "${#LANGS[@]}" -eq 0 ]; then
  printf "$(gettext 'WARNING: no voices installed in %s')\n" "$VOICES_DIR" >&2
  printf '%s\n' "$(gettext 'install piper-tts-voices-* packages or copy .onnx and .onnx.json files')" >&2
  exit 1
fi
if [ -n "$VOICE" ]; then
  if ! voice_installed "$VOICE"; then
    printf "$(gettext 'WARNING: voice not installed: %s (check spd-say -L or %s)')\n" "$VOICE" "$VOICES_DIR" >&2
    exit 1
  fi
  voice_lang=$(lang_for_voice "$VOICE" || true)
  if [ "$target" = all ]; then
    [ -n "$voice_lang" ] && target=$voice_lang
  elif [ -n "$voice_lang" ] && [ "$voice_lang" != "$target" ]; then
    printf "$(gettext 'ERROR: voice %s belongs to language %s, not %s')\n" "$VOICE" "$voice_lang" "$target" >&2
    exit 1
  fi
fi
if [ "$target" != all ] && ! voice_for "$target" >/dev/null; then
  printf "$(gettext 'WARNING: language not installed: %s (available: %s)')\n" "$target" "${LANGS[*]}" >&2
  exit 1
fi
if [ "${#TEXT_ARGS[@]}" -gt 0 ]; then
  text="${TEXT_ARGS[*]}"
else
  text="${SAMPLE[$target]:-1 2 3 4 5.}"
fi
fail=0
start_journal
if [ "$RATE" = all ]; then
  sweep=$(sweep_lang)
  if [ "$target" = all ]; then
    sweep_text="${SAMPLE[$sweep]:-1 2 3 4 5.}"
  else
    sweep_text=$text
  fi
  printf "$(gettext '== rate sweep (%s)')\n" "$sweep"
  if ! rate_sweep "$sweep" "$sweep_text"; then
    fail=1
  fi
  if [ "$fail" -eq 0 ]; then
    printf "$(gettext 'OK: test completed (%s voices installed)')\n" "${#LANGS[@]}"
  else
    printf '%s\n' "$(gettext 'ERROR: some voice failed')" >&2
  fi
  exit "$fail"
fi
if [ -n "$VOICE" ]; then
  lang_args=()
  [ "$target" != all ] && lang_args=(--lang "$target")
  echo "== voice $VOICE"
  if printf '%s\n' "$text" | "$CLIENT" --voice "$VOICE" "${lang_args[@]}" "${RATE_ARGS[@]}" --no-fallback; then
    if [ -z "$RATE" ]; then
      sweep=$(sweep_lang)
      if [ -n "$sweep" ]; then
        rate_sweep "$sweep" "$text" || exit 1
      fi
    fi
    printf "$(gettext 'OK: voice %s tested')\n" "$VOICE"
    exit 0
  fi
  printf "$(gettext 'ERROR: voice %s failed')\n" "$VOICE" >&2
  exit 1
fi
if [ "$target" = all ]; then
  for l in "${LANGS[@]}"; do
    play "$l" "${SAMPLE[$l]:-1 2 3 4 5.}" || fail=1
  done
else
  play "$target" "$text" || fail=1
fi
if [ "$fail" -eq 0 ] && [ -z "$RATE" ]; then
  sweep=$(sweep_lang)
  if [ -n "$sweep" ]; then
    if [ "$target" = all ]; then
      sweep_text="${SAMPLE[$sweep]:-1 2 3 4 5.}"
    else
      sweep_text=$text
    fi
    rate_sweep "$sweep" "$sweep_text" || fail=1
  fi
fi
if [ "$fail" -eq 0 ]; then
  printf "$(gettext 'OK: test completed (%s voices installed)')\n" "${#LANGS[@]}"
else
  printf '%s\n' "$(gettext 'ERROR: some voice failed')" >&2
fi
exit "$fail"
