"piper-tts-client: usant fallback a espeak-ng (HTTP del servidor %s: %s)"

#: src/piper_tts_server/__main__.py:15
msgid "Piper TTS server over a Unix socket with LRU cache and PCM streaming"
msgstr "Servidor Piper TTS per socket Unix amb caché LRU i streaming PCM"

#: src/piper_tts_server/__main__.py:20
msgid "Unix socket path (default $PIPER_SOCKET or /run/piper.sock)"
msgstr "Ruta del socket Unix (per defecte $PIPER_SOCKET o /run/piper.sock)"

#: src/piper_tts_server/__main__.py:25
msgid ""
"Voices directory (default $PIPER_VOICES_DIR or /usr/share/piper-voices)"
msgstr ""
"Directori de veus (per defecte $PIPER_VOICES_DIR o /usr/share/piper-voices)"

#: src/piper_tts_server/__main__.py:31
msgid "Idle seconds before exiting (default $PIPER_IDLE_SECONDS)"
msgstr "Segons d'inactivitat abans d'eixir (per defecte $PIPER_IDLE_SECONDS)"

#: src/piper_tts_server/__main__.py:37
msgid "Maximum voices in LRU cache (default $PIPER_MAX_LANGUAGES)"
msgstr "Màxim de veus en caché LRU (per defecte $PIPER_MAX_LANGUAGES)"

#: tools/piper-tts-test:60
msgid "ERROR: piper-tts-client not found: %s"
msgstr "ERROR: no s'ha trobat piper-tts-client: %s"

#: tools/piper-tts-test:122
msgid ""
"usage: %s [language|all] [text] [-l|--lang CODE] [-v|--voice NAME] "
"[-r|--rate RATE|all] [--list] [--list-languages] [--list-voices] "
"[-d|--debug]"
msgstr ""
"ús: %s [idioma|all] [text] [-l|--lang CODI] [-v|--voice NOM] [-r|--rate "
"RATE|all] [--list] [--list-languages] [--list-voices] [-d|--debug]"

#: tools/piper-tts-test:123
msgid "  -l, --lang CODE     test that specific language (ca, es, de, ...)"
msgstr "  -l, --lang CODI     prova eixe idioma concret (ca, es, de, ...)"

#: tools/piper-tts-test:124
msgid ""
"  -v, --voice NAME    test that specific voice (thorsten, pau, upc_pau, ...)"
msgstr ""
"  -v, --voice NOM    prova eixa veu concreta (thorsten, pau, upc_pau, ...)"

#: tools/piper-tts-test:125
msgid ""
"  -r, --rate RATE     slow (-60), normal (-20), fast (+30), all, or "
"-100..100"
msgstr ""
"  -r, --rate RATE     slow (-60), normal (-20), fast (+30), all o -100..100"

#: tools/piper-tts-test:126
msgid "      --list           show the combined voice table and exit"
msgstr "      --list           mostra la taula combinada de veus i ix"

#: tools/piper-tts-test:127
msgid "      --list-languages list language codes on one line and exit"
msgstr "      --list-languages llista els codis d'idioma en una línia i ix"

#: tools/piper-tts-test:128
msgid "      --list-voices    list voice names on one line and exit"
msgstr "      --list-voices    llista els noms de veu en una línia i ix"

#: tools/piper-tts-test:129
msgid "  -d, --debug          show piper-tts.service journal messages"
msgstr ""
"  -d, --debug          mostra els missatges del journal de piper-tts.service"

#: tools/piper-tts-test:130
msgid "test the Piper voices installed in %s"
msgstr "prova les veus Piper instal·lades en %s"

#: tools/piper-tts-test:194
msgid "ERROR: use only one list option"
msgstr "ERROR: usa només una opció de llistat"

#: tools/piper-tts-test:216
msgid "WARNING: journalctl not found; server messages will not be shown"
msgstr ""
"AVÍS: no s'ha trobat journalctl; no es mostraran els missatges del servidor"

#: tools/piper-tts-test:238
msgid "WARNING: could not read the piper-tts.service journal"
msgstr "AVÍS: no s'ha pogut llegir el journal de piper-tts.service"

#: tools/piper-tts-test:256
msgid "ERROR: language not installed: %s"
msgstr "ERROR: idioma no instal·lat: %s"

#: tools/piper-tts-test:261
msgid "ERROR: %s did not play"
msgstr "ERROR: %s no s'ha reproduït"

#: tools/piper-tts-test:273
msgid "[%d/%d] rate %s (%s): %s"
msgstr "[%d/%d] velocitat %s (%s): %s"

#: tools/piper-tts-test:276 tools/piper-tts-test:282
msgid "ERROR: rate %s failed"
msgstr "ERROR: la velocitat %s ha fallat"

#: tools/piper-tts-test:287
msgid "OK: rate %s tested"
msgstr "OK: velocitat %s provada"

#: tools/piper-tts-test:322
msgid "WARNING: no voices installed in %s"
msgstr "AVÍS: no hi ha veus instal·lades en %s"

#: tools/piper-tts-test:323
msgid "install piper-tts-voices-* packages or copy .onnx and .onnx.json files"
msgstr ""
"instal·la els paquets piper-tts-voices-* o copia els fitxers .onnx i "
".onnx.json"

#: tools/piper-tts-test:328
msgid "WARNING: voice not installed: %s (check spd-say -L or %s)"
msgstr "AVÍS: veu no instal·lada: %s (consulta spd-say -L o %s)"

#: tools/piper-tts-test:335
msgid "ERROR: voice %s belongs to language %s, not %s"
msgstr "ERROR: la veu %s pertany a l'idioma %s, no a %s"

#: tools/piper-tts-test:340
msgid "WARNING: language not installed: %s (available: %s)"
msgstr "AVÍS: idioma no instal·lat: %s (disponibles: %s)"

#: tools/piper-tts-test:357
msgid "== rate sweep (%s)"
msgstr "== escombratge de velocitats (%s)"

#: tools/piper-tts-test:362 tools/piper-tts-test:404
msgid "OK: test completed (%s voices installed)"
msgstr "OK: prova completada (%s veus instal·lades)"

#: tools/piper-tts-test:364 tools/piper-tts-test:406
msgid "ERROR: some voice failed"
msgstr "ERROR: alguna veu ha fallat"

#: tools/piper-tts-test:379
msgid "OK: voice %s tested"
msgstr "OK: veu %s provada"

#: tools/piper-tts-test:382
