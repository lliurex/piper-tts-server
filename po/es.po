msgstr "la velocidad debe estar entre -100 y +100"

#: src/piper_tts_server/client.py:389
msgid "Client for piper-tts-server (speech-dispatcher or direct use)"
msgstr "Cliente de piper-tts-server (speech-dispatcher o uso directo)"

#: src/piper_tts_server/client.py:392
msgid "Text to synthesize (reads from stdin if omitted)"
msgstr "Texto a sintetizar (se lee de stdin si se omite)"

#: src/piper_tts_server/client.py:394
msgid "Language code (ca, es, ...)"
msgstr "Código de idioma (ca, es, ...)"

#: src/piper_tts_server/client.py:398
msgid ""
"Voice name (thorsten, lessac, upc_pau, ...; takes precedence over --lang)"
msgstr ""
"Nombre de la voz (thorsten, lessac, upc_pau, ...; tiene prioridad sobre "
"--lang)"

#: src/piper_tts_server/client.py:403
msgid "List available languages and exit"
msgstr "Lista los idiomas disponibles y sale"

#: src/piper_tts_server/client.py:408
msgid "List available voices and exit"
msgstr "Lista las voces disponibles y sale"

#: src/piper_tts_server/client.py:417
msgid ""
"Speed: slow (-60), normal (-20), fast (+30), or a value from -100 to +100"
msgstr ""
"Velocidad: slow (-60), normal (-20), fast (+30) o un valor entre -100 y +100"

#: src/piper_tts_server/client.py:424
msgid "Volume between -100 and +100 (0 = normal)"
msgstr "Volumen entre -100 y +100 (0 = normal)"

#: src/piper_tts_server/client.py:426
