msgstr "Escribe PCM s16le crudo en stdout (sin paplay)"

#: src/piper_tts_server/client.py:435
msgid "Do not use espeak-ng if the server does not respond"
msgstr "No usar espeak-ng si el servidor no responde"

#: src/piper_tts_server/client.py:438
msgid "Socket timeout in seconds"
msgstr "Tiempo de espera del socket en segundos"

