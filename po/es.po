msgid "LOADED"
msgstr "CARGADA"

#: src/piper_tts_server/client.py:396
#, python-format
msgid "invalid speed: %s"
msgstr "velocidad no válida: %s"

#: src/piper_tts_server/client.py:398
msgid "speed must be between -100 and +100"
msgstr "la velocidad debe estar entre -100 y +100"

#: src/piper_tts_server/client.py:405
msgid "Client for piper-tts-server (speech-dispatcher or direct use)"
msgstr "Cliente de piper-tts-server (speech-dispatcher o uso directo)"

#: src/piper_tts_server/client.py:408
msgid "Text to synthesize (reads from stdin if omitted)"
msgstr "Texto a sintetizar (se lee de stdin si se omite)"

#: src/piper_tts_server/client.py:410
msgid "Language code (ca, es, ...)"
msgstr "Código de idioma (ca, es, ...)"

#: src/piper_tts_server/client.py:414
msgid ""
"Voice name (thorsten, lessac, upc_pau, ...; takes precedence over --lang)"
msgstr ""
"Nombre de la voz (thorsten, lessac, upc_pau, ...; tiene prioridad sobre "
"--lang)"

#: src/piper_tts_server/client.py:420
msgid "List voices with language, quality and load state and exit"
msgstr "Lista las voces con idioma, calidad y estado de carga y sale"

#: src/piper_tts_server/client.py:425
msgid "List language codes on one line separated by commas and exit"
msgstr "Lista los códigos de idioma en una línea separada por comas y sale"

#: src/piper_tts_server/client.py:430
msgid "List voice names on one line separated by commas and exit"
msgstr "Lista los nombres de voz en una línea separada por comas y sale"

#: src/piper_tts_server/client.py:439
msgid ""
"Speed: slow (-60), normal (-20), fast (+30), or a value from -100 to +100"
msgstr ""
"Velocidad: slow (-60), normal (-20), fast (+30) o un valor entre -100 y +100"

#: src/piper_tts_server/client.py:446
msgid "Volume between -100 and +100 (0 = normal)"
msgstr "Volumen entre -100 y +100 (0 = normal)"

#: src/piper_tts_server/client.py:448
msgid "Unix socket path"
msgstr "Ruta del socket Unix"

#: src/piper_tts_server/client.py:452
msgid "Write raw s16le PCM to stdout (no paplay)"
msgstr "Escribe PCM s16le crudo en stdout (sin paplay)"

#: src/piper_tts_server/client.py:457
msgid "Do not use espeak-ng if the server does not respond"
msgstr "No usar espeak-ng si el servidor no responde"

#: src/piper_tts_server/client.py:460
msgid "Socket timeout in seconds"
msgstr "Tiempo de espera del socket en segundos"

#: src/piper_tts_server/client.py:505 src/piper_tts_server/client.py:543
#, python-format
msgid "piper-tts-client: %s"
msgstr "piper-tts-client: %s"

